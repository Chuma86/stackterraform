pipeline {
    agent any

    environment {
        PATH     = "${PATH}:${getTerraformPath()}"
        AMI_NAME = "ami-stack-14"
    }

    stages {

        stage('Initial Stage') {
            steps {
                echo "Starting Golden AMI pipeline..."
            }
        }

        stage('Packer AMI Build') {
            steps {
                slackSend(
                    color: '#FFFF00',
                    message: "STARTING PACKER IMAGE BUILD: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'"
                )

                sh '''
                    cd images
                    export PACKER_LOG=1
                    export PACKER_LOG_PATH=$WORKSPACE/packer.log

                    packer build -force -var "ami_name=${AMI_NAME}" image.pkr.hcl
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                sh '''
                    cd instances
                    terraform init -upgrade
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                sh '''
                    cd instances
                    terraform plan -out=tfplan -input=false
                '''
            }
        }

        stage('Terraform Apply') {
            steps {
                slackSend(
                    color: '#FFFF00',
                    message: "STARTING INFRASTRUCTURE BUILD"
                )

                sh '''
                    cd instances
                    terraform apply -auto-approve tfplan
                '''
            }
        }
    }

    post {
        success {
            slackSend(color: '#36A64F', message: "✅ Golden pipeline SUCCESS")
        }
        failure {
            slackSend(color: '#FF0000', message: "❌ Golden pipeline FAILED")
        }
    }
}

def getTerraformPath() {
    return tool(name: 'terraform-14', type: 'terraform')
}
